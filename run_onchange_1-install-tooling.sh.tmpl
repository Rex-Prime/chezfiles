#!/bin/sh
set -e  # Exit on error

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

print_message() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

echo ""

{{ if eq .chezmoi.os "linux" }}

# Lua
if command -v luarocks &> /dev/null; then
    if ! command -v luacheck &> /dev/null; then
        sudo luarocks install luacheck
    fi
fi

# Python
if command -v uv &> /dev/null; then
    INSTALL_CMD="sudo uv pip install --system"
else
    print_warning "UV not found"
    print_message "Using pip instead"
    INSTALL_CMD="pip install"
fi

install_if_missing() {
local tool=$1
if ! command -v "$tool" &> /dev/null; then
    print_message "Installing $tool..."
    $INSTALL_CMD "$tool"
    print_message "$tool installed"
fi
}

install_if_missing pyright

install_if_missing ruff
install_if_missing black
install_if_missing isort

install_if_missing pylint
install_if_missing flake8

# Rust
if ! command -v rustup &> /dev/null; then
    print_message "Installing rustup..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

    source "$HOME/.cargo/env"
fi

if command -v rustup &> /dev/null; then
    for component in rust-analyzer rustfmt clippy; do
        if ! rustup component list --installed | grep -q "$component"; then
            print_message "Installing $component..."
            rustup component add "$component"
        else
            print_message "$component already installed"
        fi
    done

    if [[ ! -f ~/.zfunc/_rustup ]] || [[ ! -f ~/.zfunc/_cargo ]]; then
        echo "Generating Rust completions..."
        rustup completions zsh > ~/.zfunc/_rustup
        rustup completions zsh cargo > ~/.zfunc/_cargo
        echo "Completions installed to ~/.zfunc/"
    fi
fi

for target in wasm32-unknown-unknown; do
    if ! rustup target list --installed | grep -q "$target"; then
        print_message "Installing target: $target..."
        rustup target add "$target"
    fi
done

{{ end }}
